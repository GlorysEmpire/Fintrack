# ── Database (PostgreSQL — required) ──────────────────────────
# Neon: https://console.neon.tech → create project → copy connection string
# Vercel Postgres: Storage → Create → Postgres → .env.local
# Local: postgresql://USER:PASSWORD@localhost:5432/fintrack
DATABASE_URL="postgresql://USER:PASSWORD@HOST/fintrack?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────
# Long random string (openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-long-random-string"

# true ONLY on your machine — never on Vercel production
AUTH_DEV_SHOW_CODE="true"

# ── Email (Resend) — required for production login codes ──────
# https://resend.com → API Keys
RESEND_API_KEY=""
# Use your verified domain in production, e.g. FinTrack <login@fintrack.app>
EMAIL_FROM="FinTrack <onboarding@resend.dev>"

# ── AI (optional — offline coach works without this) ──────────
XAI_API_KEY=""
XAI_MODEL="grok-4-1-fast-non-reasoning"
