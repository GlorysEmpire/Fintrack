// FinTrack database schema — PostgreSQL for local + Vercel production.
// Set DATABASE_URL in .env (Neon / Vercel Postgres / local Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemePreference {
  system
  light
  dark
}

enum RecurringCadence {
  daily
  weekly
  monthly
}

enum HouseholdRole {
  owner
  member
}

// Someone who can sign in. Created on first successful OTP verify.
// passwordHash is optional — OTP-only users keep null until they set a password.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  /// Argon2id PHC string. Null = OTP-only account (legacy / not set yet).
  passwordHash String?
  baseCurrency String  @default("NGN")
  /// pending = must see onboarding · completed = has plan · skipped = no plan yet
  onboarding   String  @default("pending")
  theme        ThemePreference @default(system)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  otps          EmailOtp[]
  plan          BudgetPlan?
  transactions  Transaction[]
  incomeSources IncomeSource[]
  inbox         InboxMessage[]
  aiMessages    AiMessage[]
  recurringRules RecurringRule[]
  householdMemberships HouseholdMember[]
  /// JSON string of FX rates (NGN-denominated)
  fxRates       String @default("{\"NGN\":1,\"USD\":1580,\"GBP\":1990,\"EUR\":1710}")
  /// JSON: { order: string[], hidden: string[] } — dashboard section preferences
  dashboardLayoutJson String @default("")
}

// Shared household (schema only — UI in a follow-up)
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  HouseholdMember[]
  plans    BudgetPlan[]
  transactions Transaction[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        HouseholdRole @default(member)
  createdAt   DateTime      @default(now())

  @@unique([householdId, userId])
  @@index([userId])
}

// AI / system accountability messages (override coaching, monthly review, etc.)
model InboxMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// override_coach | monthly_review | plan_tip | system
  kind      String   @default("system")
  title     String
  body      String
  read      Boolean  @default(false)
  /// Optional link to a transaction that triggered the message
  relatedTxId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Short chat history for AI Advisor tab (server-side only)
model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// user | assistant
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Browser session — token lives in httpOnly cookie "ft_session"
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// One-time email login codes (valid ~10 minutes)
model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  /// Wrong-code guesses; at 5 the OTP is invalidated
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

// One plan per user for now (households come later)
model BudgetPlan {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional shared household (schema only — not wired in UI yet)
  householdId               String?
  household                 Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  name                      String
  templateId                String?
  emergencyCarryOverDefault Boolean  @default(true)
  /// JSON array of PlanBucket from @fintrack/domain
  bucketsJson               String
  /// JSON map bucketId → opening balance from carry-over months
  openingBalancesJson       String   @default("{}")
  /// YYYY-MM of the last month we packed (opening balances written). Null = never packed.
  lastMonthClosed String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([householdId])
}

// Ready for Sprint 2 income sources
model IncomeSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("other")
  emoji     String   @default("💵")
  currency  String   @default("NGN")
  amount    Float    @default(0)
  createdAt DateTime @default(now())
}

// Ready for Sprint 2 transactions (income / expense)
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional shared household (schema only)
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  /// "i" = income · "e" = expense
  type      String
  amount    Float
  currency  String   @default("NGN")
  bucketId  String?
  category  String?
  sourceId  String?
  note      String?
  /// User intentionally spent outside the "normal" bucket
  override  Boolean  @default(false)
  reason    String?
  /// Set when created by a recurring rule expansion
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([householdId])
  @@index([recurringRuleId])
}

// Recurring income/expense rules expanded by daily cron
model RecurringRule {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "i" | "e"
  type       String           @default("e")
  amount     Float
  currency   String           @default("NGN")
  bucketId   String?
  sourceId   String?
  note       String?
  cadence    RecurringCadence
  /// 1–31 for monthly; ignored for daily/weekly
  dayOfMonth Int?
  nextRunAt  DateTime
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  transactions Transaction[]

  @@index([userId, active, nextRunAt])
}
