// FinTrack database schema — PostgreSQL for local + Vercel production.
// Set DATABASE_URL in .env (Neon / Vercel Postgres / local Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemePreference {
  system
  light
  dark
}

enum RecurringCadence {
  daily
  weekly
  monthly
}

enum HouseholdRole {
  owner
  member
}

// Someone who can sign in. Created on first successful OTP verify.
// passwordHash is optional — OTP-only users keep null until they set a password.
model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  /// Argon2id PHC string. Null = OTP-only account (legacy / not set yet).
  passwordHash String?
  baseCurrency String          @default("NGN")
  /// pending = must see onboarding · completed = has plan · skipped = no plan yet
  onboarding   String          @default("pending")
  theme        ThemePreference @default(system)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sessions             Session[]
  otps                 EmailOtp[]
  plan                 BudgetPlan?
  transactions         Transaction[]
  incomeSources        IncomeSource[]
  inbox                InboxMessage[]
  aiMessages           AiMessage[]
  recurringRules       RecurringRule[]
  accounts             Account[]
  transfers            Transfer[]
  accountAdjustments   AccountAdjustment[]
  bankConnections      BankConnection[]
  importedTransactions ImportedTransaction[]
  householdMemberships HouseholdMember[]
  /// JSON string of FX rates (NGN-denominated)
  fxRates              String                @default("{\"NGN\":1,\"USD\":1580,\"GBP\":1990,\"EUR\":1710}")
  /// JSON: { order: string[], hidden: string[] } — dashboard section preferences
  dashboardLayoutJson  String                @default("")
}

// Shared household (schema only — UI in a follow-up)
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      HouseholdMember[]
  plans        BudgetPlan[]
  transactions Transaction[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        HouseholdRole @default(member)
  createdAt   DateTime      @default(now())

  @@unique([householdId, userId])
  @@index([userId])
}

// AI / system accountability messages (override coaching, monthly review, etc.)
model InboxMessage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// override_coach | monthly_review | plan_tip | system
  kind        String   @default("system")
  title       String
  body        String
  read        Boolean  @default(false)
  /// Optional link to a transaction that triggered the message
  relatedTxId String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Short chat history for AI Advisor tab (server-side only)
model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// user | assistant
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Browser session — token lives in httpOnly cookie "ft_session"
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// One-time email login codes (valid ~10 minutes)
model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  /// Wrong-code guesses; at 5 the OTP is invalidated
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

// One plan per user for now (households come later)
model BudgetPlan {
  id                        String     @id @default(cuid())
  userId                    String     @unique
  user                      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional shared household (schema only — not wired in UI yet)
  householdId               String?
  household                 Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  name                      String
  templateId                String?
  emergencyCarryOverDefault Boolean    @default(true)
  /// JSON array of PlanBucket from @fintrack/domain
  bucketsJson               String
  /// JSON map bucketId → opening balance from carry-over months
  openingBalancesJson       String     @default("{}")
  /// YYYY-MM of the last month we packed (opening balances written). Null = never packed.
  lastMonthClosed           String?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  @@index([householdId])
}

// Ready for Sprint 2 income sources
model IncomeSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("other")
  emoji     String   @default("💵")
  currency  String   @default("NGN")
  amount    Float    @default(0)
  createdAt DateTime @default(now())
}

// Ready for Sprint 2 transactions (income / expense)
//
// LEFTOVER COLUMN: migration 20261005150000_transaction_overspend added a
// boolean "overspend" column for a warn-and-confirm overspend flow. The product
// rule is now "a bucket is blocked at zero", so nothing reads or writes it and
// it is no longer part of this model. The column is deliberately still in the
// database: dropping it while the previous version of the app is still serving
// would break that version (it selects the column). Remove it with its own
// migration once this version is the one that is live:
//   ALTER TABLE "Transaction" DROP COLUMN IF EXISTS "overspend";
model Transaction {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional shared household (schema only)
  householdId     String?
  household       Household?     @relation(fields: [householdId], references: [id], onDelete: SetNull)
  /// "i" = income · "e" = expense
  type            String
  amount          Float
  currency        String         @default("NGN")
  bucketId        String?
  category        String?
  sourceId        String?
  note            String?
  /// User intentionally spent outside the "normal" bucket
  override        Boolean        @default(false)
  reason          String?
  /// Set when created by a recurring rule expansion
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  /// Which scheduled occurrence of the rule this is (the day, at noon UTC).
  /// With recurringRuleId it is unique, so one occurrence can only ever be
  /// recorded once, however many times the job runs. Null for everything else.
  occurrenceDate  DateTime?
  /// Where the money was held or paid from. Null = not assigned to an account
  /// (all history from before accounts existed). Never guessed or back-filled.
  accountId       String?
  account         Account?       @relation(fields: [accountId], references: [id], onDelete: NoAction)
  /// Set when this expense is the fee charged for a transfer. It lives and dies
  /// with that transfer, and can not be edited or deleted on its own.
  transferId      String?        @unique
  transfer        Transfer?      @relation("TransferFee", fields: [transferId], references: [id], onDelete: Cascade)
  /// The bank import this transaction was created from (set in the same write
  /// that creates it). Unique, so one import can never become two transactions.
  importId        String?        @unique
  /// When it happened (the user may file a transaction under an earlier day)
  date            DateTime       @default(now())
  /// When it was recorded. Starts the edit window; never set by the client.
  createdAt       DateTime       @default(now())

  @@unique([recurringRuleId, occurrenceDate])
  @@index([userId, date])
  @@index([householdId])
  @@index([recurringRuleId])
  @@index([accountId])
}

// Recurring income/expense rules expanded by daily cron
model RecurringRule {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "i" | "e"
  type       String           @default("e")
  amount     Float
  currency   String           @default("NGN")
  bucketId   String?
  sourceId   String?
  /// Account the generated transactions are recorded against (optional)
  accountId  String?
  note       String?
  cadence    RecurringCadence
  /// 1–31 for monthly; ignored for daily/weekly
  dayOfMonth Int?
  /// The next occurrence to generate (a day, at noon UTC)
  nextRunAt  DateTime
  active     Boolean          @default(true)
  /// When the job last handled this rule, and why its last run did not go
  /// cleanly (a plain sentence, never an amount). Null = nothing wrong.
  lastRunAt  DateTime?
  lastError  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  transactions Transaction[]

  @@index([userId, active, nextRunAt])
}

// Where money is held (asset) or where a debt sits (liability). The balance is
// NEVER stored: it is derived from the opening balance and the events dated on
// or after the opening date (see packages/domain/src/accounts.ts). Accounts are
// archived, never deleted, while history refers to them.
model Account {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  /// "asset" | "liability"
  kind                String
  /// bank | cash | wallet | savings | investment | credit_card | loan | other_asset | other_liability
  type                String
  institution         String?
  currency            String          @default("NGN")
  /// Signed minor units (kobo/cents). A debt is negative: owing 20,000 is -2000000.
  openingBalanceMinor BigInt          @default(0)
  /// Events before this moment are already inside the opening balance
  openingDate         DateTime
  /// active | archived | disconnected
  status              String          @default("active")
  /// Set when the account is read from a bank connection (read-only)
  provider            String?
  externalAccountId   String?
  connectionId        String?
  connection          BankConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  transactions Transaction[]
  transfersOut Transfer[]            @relation("TransferFrom")
  transfersIn  Transfer[]            @relation("TransferTo")
  adjustments  AccountAdjustment[]
  imports      ImportedTransaction[]

  @@unique([userId, name])
  @@unique([connectionId, externalAccountId])
  @@index([userId])
}

// Money moved between two of the user's own accounts. ONE row is both sides of
// the movement, so the two sides can never drift apart and creating it is
// atomic by nature. A transfer is never income and never spending.
model Transfer {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId   String
  fromAccount     Account      @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: NoAction)
  toAccountId     String
  toAccount       Account      @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: NoAction)
  /// Minor units that left the source, in the source's currency
  fromAmountMinor BigInt
  /// Minor units that arrived, in the destination's currency (stated, never assumed)
  toAmountMinor   BigInt
  /// What the transfer cost, in the source account's currency. Recorded as an
  /// ordinary expense transaction (feeTransaction), so it counts once, as
  /// spending; the amount is kept here for display.
  feeMinor        BigInt       @default(0)
  feeTransaction  Transaction? @relation("TransferFee")
  /// Informational only (destination units per source unit); never used in arithmetic
  exchangeRate    Float?
  /// The day it happened
  date            DateTime
  /// When it was recorded; starts the edit window
  createdAt       DateTime     @default(now())
  note            String?
  reference       String?
  /// posted (more later, for imports: pending)
  status          String       @default("posted")
  /// manual (later: import)
  source          String       @default("manual")

  @@index([userId, date])
  @@index([fromAccountId])
  @@index([toAccountId])
}

// A correction so a derived balance matches the real one. Not income, not spending.
model AccountAdjustment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: NoAction)
  /// Signed minor units added to the balance
  amountMinor BigInt
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@index([accountId])
  @@index([userId])
}

// A READ-ONLY link to a bank, through a provider (see lib/bank). Holds consent
// and sync state only. There is deliberately no credential here: when a real
// provider is chosen, access tokens must be stored encrypted at rest. Nothing in
// this model can move money.
model BankConnection {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which adapter reads it (e.g. "mock"). Provider details stay behind the adapter.
  provider            String
  /// active | error (stopped after repeated failures; needs the person) | revoked | expired
  status              String    @default("active")
  consentGrantedAt    DateTime  @default(now())
  /// When the provider's consent lapses, if it says
  consentExpiresAt    DateTime?
  revokedAt           DateTime?
  /// Where the next sync resumes (provider-defined)
  cursor              String?
  lastSyncAt          DateTime?
  lastSuccessAt       DateTime?
  /// A plain sentence about the last failure; never provider payloads or secrets
  lastError           String?
  consecutiveFailures Int       @default(0)
  nextRetryAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts Account[]
  imports  ImportedTransaction[]

  @@index([userId])
}

// What a provider says happened at a bank. NOT a FinTrack transaction until a
// person reviews it. (connectionId, externalId) is unique, so the same provider
// transaction can never be imported twice.
model ImportedTransaction {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId        String
  connection          BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accountId           String
  account             Account        @relation(fields: [accountId], references: [id], onDelete: NoAction)
  /// The provider's own id for the transaction
  externalId          String
  /// pending | posted | reversed
  status              String
  /// Signed minor units in `currency`: money in is positive
  amountMinor         BigInt
  currency            String
  /// What the provider originally reported, when it differs from the above
  originalAmountMinor BigInt?
  originalCurrency    String?
  /// When it happened at the bank
  occurredAt          DateTime
  description         String?
  counterparty        String?
  /// new | accepted | matched | ignored
  review              String         @default("new")
  /// The FinTrack transaction this became (accepted) or was matched to (an id only)
  transactionId       String?        @unique
  /// Set when the bank changed something the person had already acted on
  attention           String?
  firstSeenAt         DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([connectionId, externalId])
  @@index([userId, review])
  @@index([accountId])
}
